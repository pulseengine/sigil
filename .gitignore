*.wasm

# Key files
*.key
*.key2

# Scripts (local testing) - but allow anything CI actually runs.
#
# `*.sh` with only `!scripts/*.sh` negated silently dropped a new gate script
# under verification/: `git add -A` skipped it without a word, the commit looked
# clean, and the workflow step referencing it failed in CI with exit 127 — a
# gate that ran nothing. Exit 127 was luck; `bash foo.sh || true` would have
# been green. Any directory whose scripts a workflow invokes must be negated
# here, and the vacuous-oracle gate now asserts that every `bash <path>.sh` a
# workflow runs is a TRACKED file, so the next omission fails loudly instead.
*.sh
!scripts/*.sh
!scripts/**/*.sh
!verification/**/*.sh
!.github/**/*.sh

# Signatures
/signature

# Old binary name
wasmsign2
.env

# Rivet external project cache
.rivet/

# Nix / direnv
.direnv/
result

# Local audit working notes (intentionally untracked — formal findings
# land in docs/security/ once distilled).
/audit/

# Python bytecode (claim-check, verification scripts)
__pycache__/
*.pyc

# Per-user agent settings (local permissions); never committed.
.claude/settings.local.json
